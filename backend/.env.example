# Database Configuration
DATABASE_URL="postgresql://prisma:prisma@localhost:5432/automation?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=3000

# Security - Generate a 32-byte base64 key using:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY="your-32-byte-base64-encoded-key-here"

# JWT Secret for authentication
JWT_SECRET="your-random-jwt-secret-key-here"

# OAuth Configuration
# Frontend URL for OAuth callbacks
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:3000"

# Google OAuth - Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/oauth/google/callback"

# GitHub OAuth - Get from https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3000/auth/oauth/github/callback"

# LinkedIn OAuth - Get from https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_CALLBACK_URL="http://localhost:3000/auth/oauth/linkedin/callback"

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"

# Get your chat ID by messaging your bot and visiting:
# https://api.telegram.org/bot<YourBOTToken>/getUpdates
TELEGRAM_CHAT_ID="your-telegram-chat-id-here"
