/**
 * Comprehensive Integration Tests for Workflow API
 * 
 * Note: These tests require the backend server to be running on http://localhost:3000
 * Run `npm run dev` in the backend directory before running these tests
 */

import axios from "axios";
import { PrismaClient } from "@prisma/client";

const prisma = new PrismaClient();
const BASE_URL = "http://localhost:3000";

describe("Workflow API", () => {
  let testWorkflowId: string;

  // Clean up test data after all tests
  afterAll(async () => {
    if (testWorkflowId) {
      await prisma.execution.deleteMany({
        where: { workflowId: testWorkflowId },
      });
    }
    await prisma.workflow.deleteMany({
      where: { name: { contains: "Test Workflow" } },
    });
    await prisma.$disconnect();
  });

  describe("POST /workflows - Create Workflow", () => {
    it("should create a workflow with valid data", async () => {
      const workflowData = {
        name: "Test Workflow - Create",
        definition: {
          nodes: [
            {
              id: "node1",
              type: "trigger",
              name: "Start",
              position: { x: 100, y: 100 },
              data: {},
              config: {},
            },
          ],
          edges: [],
        },
      };

      const response = await axios.post(`${BASE_URL}/workflows`, workflowData);
      const data = response.data;

      expect(response.status).toBe(200);
      expect(data).toHaveProperty("id");
      expect(data.name).toBe(workflowData.name);
      expect(data.versions).toBeDefined();
      expect(data.versions.length).toBe(1);
      expect(data.versions[0].versionNumber).toBe(1);
      expect(data.versions[0].isDraft).toBe(true);

      testWorkflowId = data.id;
    });

    it("should normalize workflow definition", async () => {
      const workflowData = {
        name: "Test Workflow - Normalize",
        definition: {
          nodes: [
            {
              id: "node1",
              type: "trigger",
              // Missing name, position, data, config
            },
          ],
          edges: [],
        },
      };

      const response = await request("POST", "/workflows", workflowData);
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(data.versions[0].definition.nodes[0]).toHaveProperty("name");
      expect(data.versions[0].definition.nodes[0]).toHaveProperty("position");
      expect(data.versions[0].definition.nodes[0]).toHaveProperty("data");
      expect(data.versions[0].definition.nodes[0]).toHaveProperty("config");
    });

    it("should reject invalid workflow definition", async () => {
      const invalidData = {
        name: "Test Workflow - Invalid",
        definition: {
          nodes: "invalid", // Should be an array
          edges: [],
        },
      };

      const response = await request("POST", "/workflows", invalidData);
      expect(response.status).toBe(400);
    });
  });

  describe("GET /workflows - List Workflows", () => {
    beforeAll(async () => {
      // Create test workflows
      await prisma.workflow.create({
        data: {
          name: "Test Workflow - Published",
          versions: {
            create: {
              versionNumber: 1,
              definition: { nodes: [], edges: [] },
              isDraft: false,
            },
          },
        },
      });

      await prisma.workflow.create({
        data: {
          name: "Test Workflow - Draft",
          versions: {
            create: {
              versionNumber: 1,
              definition: { nodes: [], edges: [] },
              isDraft: true,
            },
          },
        },
      });
    });

    it("should return workflows with pagination metadata", async () => {
      const response = await request("GET", "/workflows?page=1&limit=10");
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(data).toHaveProperty("workflows");
      expect(data).toHaveProperty("pagination");
      expect(data.pagination).toHaveProperty("total");
      expect(data.pagination).toHaveProperty("page");
      expect(data.pagination).toHaveProperty("limit");
      expect(data.pagination).toHaveProperty("totalPages");
    });

    it("should filter workflows by search term", async () => {
      const response = await request("GET", "/workflows?search=Published");
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(Array.isArray(data.workflows)).toBe(true);
      data.workflows.forEach((wf: any) => {
        expect(wf.name.toLowerCase()).toContain("published");
      });
    });

    it("should filter published workflows", async () => {
      const response = await request("GET", "/workflows?status=published");
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(Array.isArray(data.workflows)).toBe(true);
    });

    it("should filter draft workflows", async () => {
      const response = await request("GET", "/workflows?status=draft");
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(Array.isArray(data.workflows)).toBe(true);
    });

    it("should sort workflows by name ascending", async () => {
      const response = await request(
        "GET",
        "/workflows?sort=name&order=asc&limit=10"
      );
      const data = await response.json();

      expect(response.status).toBe(200);
      if (data.workflows.length > 1) {
        for (let i = 0; i < data.workflows.length - 1; i++) {
          expect(data.workflows[i].name.toLowerCase()).toBeLessThanOrEqual(
            data.workflows[i + 1].name.toLowerCase()
          );
        }
      }
    });

    it("should include version and execution counts", async () => {
      const response = await request("GET", "/workflows?limit=1");
      const data = await response.json();

      expect(response.status).toBe(200);
      if (data.workflows.length > 0) {
        expect(data.workflows[0]).toHaveProperty("_count");
        expect(data.workflows[0]._count).toHaveProperty("versions");
        expect(data.workflows[0]._count).toHaveProperty("executions");
      }
    });

    it("should include only latest version", async () => {
      const response = await request("GET", "/workflows?limit=1");
      const data = await response.json();

      expect(response.status).toBe(200);
      if (data.workflows.length > 0) {
        expect(data.workflows[0].versions).toBeDefined();
        expect(data.workflows[0].versions.length).toBeLessThanOrEqual(1);
      }
    });
  });

  describe("GET /workflows/:id - Get Single Workflow", () => {
    let workflowId: string;

    beforeAll(async () => {
      const workflow = await prisma.workflow.create({
        data: {
          name: "Test Workflow - Get",
          versions: {
            create: {
              versionNumber: 1,
              definition: { nodes: [], edges: [] },
              isDraft: true,
            },
          },
        },
      });
      workflowId = workflow.id;
    });

    it("should return workflow by id", async () => {
      const response = await request("GET", `/workflows/${workflowId}`);
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(data.id).toBe(workflowId);
      expect(data.name).toBe("Test Workflow - Get");
    });

    it("should return 404 for non-existent workflow", async () => {
      const response = await request(
        "GET",
        "/workflows/00000000-0000-0000-0000-000000000000"
      );
      const data = await response.json();

      expect(response.status).toBe(404);
      expect(data).toHaveProperty("error");
    });
  });

  describe("PUT /workflows/:id - Update Workflow", () => {
    let workflowId: string;

    beforeAll(async () => {
      const workflow = await prisma.workflow.create({
        data: {
          name: "Test Workflow - Update",
          versions: {
            create: {
              versionNumber: 1,
              definition: { nodes: [], edges: [] },
              isDraft: true,
            },
          },
        },
      });
      workflowId = workflow.id;
    });

    it("should update workflow and create new version", async () => {
      const updateData = {
        name: "Test Workflow - Updated",
        definition: {
          nodes: [
            {
              id: "node1",
              type: "trigger",
              name: "Updated Node",
              position: { x: 200, y: 200 },
              data: {},
              config: {},
            },
          ],
          edges: [],
        },
      };

      const response = await request(
        "PUT",
        `/workflows/${workflowId}`,
        updateData
      );
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(data.name).toBe(updateData.name);
      expect(data.versions.length).toBeGreaterThan(1);
      expect(data.versions[data.versions.length - 1].versionNumber).toBe(2);
    });

    it("should normalize updated workflow definition", async () => {
      const updateData = {
        name: "Test Workflow - Normalized Update",
        definition: {
          nodes: [
            {
              id: "node1",
              type: "trigger",
              // Missing optional fields
            },
          ],
          edges: [],
        },
      };

      const response = await request(
        "PUT",
        `/workflows/${workflowId}`,
        updateData
      );
      const data = await response.json();

      expect(response.status).toBe(200);
      const latestVersion = data.versions[data.versions.length - 1];
      expect(latestVersion.definition.nodes[0]).toHaveProperty("name");
      expect(latestVersion.definition.nodes[0]).toHaveProperty("position");
    });
  });

  describe("DELETE /workflows/:id - Delete Workflow", () => {
    it("should delete workflow and its executions", async () => {
      // Create a workflow to delete
      const workflow = await prisma.workflow.create({
        data: {
          name: "Test Workflow - Delete",
          versions: {
            create: {
              versionNumber: 1,
              definition: { nodes: [], edges: [] },
              isDraft: true,
            },
          },
        },
      });

      // Create an execution
      await prisma.execution.create({
        data: {
          workflowId: workflow.id,
          versionId: workflow.versions[0].id,
          status: "completed",
          input: {},
          definitionSnapshot: { nodes: [], edges: [] },
        },
      });

      const response = await request("DELETE", `/workflows/${workflow.id}`);
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(data.success).toBe(true);

      // Verify workflow is deleted
      const deleted = await prisma.workflow.findUnique({
        where: { id: workflow.id },
      });
      expect(deleted).toBeNull();
    });
  });

  describe("POST /workflows/:id/execute - Execute Workflow", () => {
    let workflowId: string;
    let versionId: string;

    beforeAll(async () => {
      const workflow = await prisma.workflow.create({
        data: {
          name: "Test Workflow - Execute",
          versions: {
            create: {
              versionNumber: 1,
              definition: {
                nodes: [
                  {
                    id: "node1",
                    type: "trigger",
                    name: "Start",
                    position: { x: 0, y: 0 },
                    data: {},
                    config: {},
                  },
                ],
                edges: [],
              },
              isDraft: false,
            },
          },
        },
      });
      
      // Fetch with versions included
      const workflowWithVersions = await prisma.workflow.findUnique({
        where: { id: workflow.id },
        include: { versions: true },
      });
      
      workflowId = workflow.id;
      if (workflowWithVersions?.versions[0]) {
        versionId = workflowWithVersions.versions[0].id;
      }
    });

    beforeEach(() => {
      // Clear mock before each test
      (mockQueue.add as jest.Mock).mockClear();
    });

    it("should execute workflow with published version", async () => {
      const input = { testData: "value" };
      const response = await request(
        "POST",
        `/workflows/${workflowId}/execute`,
        input
      );
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(data).toHaveProperty("executionId");
      expect(data).toHaveProperty("versionId");
      expect(data.versionId).toBe(versionId);

      // Verify execution was created
      const execution = await prisma.execution.findUnique({
        where: { id: data.executionId },
      });
      expect(execution).toBeDefined();
      expect(execution?.status).toBe("queued");
      expect(execution?.input).toEqual(input);

      // Verify job was added to queue
      expect(mockQueue.add).toHaveBeenCalledWith(
        "execute-workflow",
        { executionId: data.executionId },
        expect.objectContaining({
          attempts: 3,
          backoff: { type: "exponential", delay: 500 },
        })
      );
    });

    it("should execute workflow with latest version if no published version", async () => {
      // Create workflow with only draft version
      const draftWorkflow = await prisma.workflow.create({
        data: {
          name: "Test Workflow - Draft Execute",
          versions: {
            create: {
              versionNumber: 1,
              definition: { nodes: [], edges: [] },
              isDraft: true,
            },
          },
        },
      });
      
      // Fetch with versions included
      const workflowWithVersions = await prisma.workflow.findUnique({
        where: { id: draftWorkflow.id },
        include: { versions: true },
      });

      const response = await request(
        "POST",
        `/workflows/${draftWorkflow.id}/execute`,
        {}
      );
      const data = await response.json();

      expect(response.status).toBe(200);
      expect(data).toHaveProperty("executionId");
      if (workflowWithVersions?.versions[0]) {
        expect(data.versionId).toBe(workflowWithVersions.versions[0].id);
      }
    });

    it("should return 404 for non-existent workflow", async () => {
      const response = await request(
        "POST",
        "/workflows/00000000-0000-0000-0000-000000000000/execute",
        {}
      );
      const data = await response.json();

      expect(response.status).toBe(404);
      expect(data).toHaveProperty("error");
    });

    it("should store definition snapshot in execution", async () => {
      const response = await request(
        "POST",
        `/workflows/${workflowId}/execute`,
        {}
      );
      const data = await response.json();

      const execution = await prisma.execution.findUnique({
        where: { id: data.executionId },
      });

      expect(execution?.definitionSnapshot).toBeDefined();
      expect(execution?.definitionSnapshot).toHaveProperty("nodes");
      expect(execution?.definitionSnapshot).toHaveProperty("edges");
    });
  });
});
