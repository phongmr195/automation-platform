datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------
// AUTHENTICATION & USERS
// -------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // bcrypt hashed (nullable for OAuth-only users)
  name      String?
  avatar    String?  // Profile picture URL
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OAuth provider IDs
  googleId   String? @unique
  githubId   String? @unique
  linkedinId String? @unique

  sessions    Session[]
  workflows   Workflow[]
  credentials Credential[]
  organizationMembers OrganizationMember[]
  auditLogs   AuditLog[]
  templates   WorkflowTemplate[]
  templateReviews TemplateReview[]
  templateComments TemplateComment[]
  
  // Collaboration
  workflowCollaborations WorkflowCollaborator[]
  workflowComments       WorkflowComment[]
  workflowActivities     WorkflowActivity[]
  workflowNotifications  WorkflowNotification[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// -------------------------------------------------------
// ORGANIZATION & MULTI-TENANCY
// -------------------------------------------------------
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  workflows   Workflow[]
  credentials Credential[]
  auditLogs   AuditLog[]
  folders     WorkflowFolder[]
  customNodeInstalls CustomNodeInstall[]
  holidayCalendars HolidayCalendar[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action         String        // e.g., "workflow.created", "member.invited"
  resourceType   String        // e.g., "workflow", "member", "credential"
  resourceId     String?
  metadata       Json?         // Additional context
  ipAddress      String?
  userAgent      String?
  
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// -------------------------------------------------------
// WORKFLOW
// -------------------------------------------------------
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(false)
  
  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Owner
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  
  // Workflow definition (nodes, connections)
  nodes       Json     @default("[]")
  connections Json     @default("[]")
  
  // Triggers & Settings
  triggers    Json     @default("[]")
  settings    Json?
  
  // Organization features
  starred     Boolean  @default(false)
  folderId    String?
  folder      WorkflowFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  lastOpenedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Published version
  publishedVersionId String?          @unique
  publishedVersion   WorkflowVersion? @relation("PublishedVersionRelation", fields: [publishedVersionId], references: [id])

  // All versions
  versions WorkflowVersion[]

  executions Execution[]
  metrics    WorkflowMetrics?
  scheduleConfig ScheduleConfig?
  
  // Version control
  commits       WorkflowCommit[]
  branches      WorkflowBranch[]
  diffs         WorkflowDiff[]
  snapshots     WorkflowSnapshot[]
  mergeRequests WorkflowMergeRequest[]
  
  // Collaboration
  collaborators WorkflowCollaborator[]
  comments      WorkflowComment[]
  activities    WorkflowActivity[]
  notifications WorkflowNotification[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([folderId])
  @@index([starred])
  @@index([lastOpenedAt])
}

// -------------------------------------------------------
// WORKFLOW FOLDER
// -------------------------------------------------------
model WorkflowFolder {
  id             String   @id @default(cuid())
  name           String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workflows Workflow[]

  @@index([organizationId])
}

// -------------------------------------------------------
// WORKFLOW VERSION
// -------------------------------------------------------
model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  versionNumber Int
  definition    Json
  isDraft       Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Back relation for published version
  publishedInWorkflow Workflow? @relation("PublishedVersionRelation")

  executions Execution[]
  commits    WorkflowCommit[]
}

// -------------------------------------------------------
// EXECUTION
// -------------------------------------------------------
model Execution {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  versionId String?
  version   WorkflowVersion? @relation(fields: [versionId], references: [id])

  status     String   // 'pending' | 'running' | 'success' | 'failed' | 'cancelled'
  input      Json?
  output     Json?
  error      String?
  nodeResults Json?   // Results from each node
  definitionSnapshot Json?
  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs NodeLog[]
  scheduleLogs ScheduleLog[]
}

// -------------------------------------------------------
// NODE LOG
// -------------------------------------------------------
model NodeLog {
  id String @id @default(cuid())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id])

  nodeId String
  status String
  data   Json?

  createdAt DateTime @default(now())
}

model Credential {
  id        String   @id @default(cuid())
  ownerId   String   // user id
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name      String
  provider  String   // e.g., "openai", "google", "slack", "http"
  type      String   // "apiKey" | "oauth" | "basic"
  encrypted Bytes    // ciphertext
  iv        Bytes
  meta      Json?    // e.g. { scopes: [...], expiresAt: '...' }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([organizationId])
}

// -------------------------------------------------------
// WORKFLOW TEMPLATES
// -------------------------------------------------------
model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // e.g., "marketing", "data-sync", "notifications", "etl", "api-integration", "social-media"
  tags        String[] // Searchable tags
  
  // Template metadata
  icon        String?  // Icon identifier or emoji
  difficulty  String   @default("beginner") // "beginner" | "intermediate" | "advanced"
  estimatedTime String?  // e.g., "5 minutes", "1 hour"
  featured    Boolean  @default(false)
  
  // Template definition
  nodes       Json     @default("[]")
  connections Json     @default("[]")
  triggers    Json     @default("[]")
  settings    Json?
  
  // Configuration parameters that users need to fill
  requiredParams Json?  // List of parameters users must configure
  
  // Version control
  version     String   @default("1.0.0")
  changelog   String?
  
  // Usage statistics
  installCount Int     @default(0)
  rating      Float?   @default(0)
  
  // Author info
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  // Publishing
  published   Boolean  @default(true)
  publishedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Marketplace relations
  reviews     TemplateReview[]
  comments    TemplateComment[]

  @@index([category])
  @@index([featured])
  @@index([published])
  @@index([authorId])
}

// -------------------------------------------------------
// TEMPLATE REVIEWS & RATINGS
// -------------------------------------------------------
model TemplateReview {
  id         String   @id @default(cuid())
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating     Int      // 1-5 stars
  title      String?  // Review title
  content    String?  // Review text
  
  // Helpful votes
  helpfulCount Int    @default(0)
  
  // Moderation
  verified   Boolean  @default(false) // Verified purchase/usage
  featured   Boolean  @default(false)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([templateId, userId]) // One review per user per template
  @@index([templateId])
  @@index([userId])
  @@index([rating])
}

// -------------------------------------------------------
// TEMPLATE COMMENTS
// -------------------------------------------------------
model TemplateComment {
  id         String   @id @default(cuid())
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content    String
  
  // Threading (replies)
  parentId   String?
  parent     TemplateComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    TemplateComment[] @relation("CommentReplies")
  
  // Engagement
  upvotes    Int      @default(0)
  
  // Moderation
  edited     Boolean  @default(false)
  deleted    Boolean  @default(false)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([templateId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

// -------------------------------------------------------
// CUSTOM NODES (Like n8n Community Nodes)
// -------------------------------------------------------
model CustomNode {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "my-custom-node"
  displayName String   // e.g., "My Custom Node"
  description String
  author      String   // User ID or organization
  authorName  String   // Display name
  category    String   // e.g., "communication", "transform", "integration"
  icon        String?  // Icon name or URL
  iconUrl     String?
  color       String?  // Hex color
  
  // Publishing status
  status      String   @default("draft") // draft, published, deprecated
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  verified    Boolean  @default(false) // Verified by platform
  
  // Metadata
  repository  String?  // GitHub repo URL
  homepage    String?  // Documentation URL
  license     String?  // MIT, Apache-2.0, etc.
  keywords    String[] // Search keywords
  
  // Stats
  downloads   Int      @default(0)
  installs    Int      @default(0)
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
  
  // Relations
  versions    CustomNodeVersion[]
  installs_rel CustomNodeInstall[]
  reviews     CustomNodeReview[]
  
  @@index([name])
  @@index([category])
  @@index([published])
  @@index([featured])
  @@index([downloads])
  @@index([rating])
}

model CustomNodeVersion {
  id          String   @id @default(cuid())
  nodeId      String
  version     String   // Semver: 1.0.0
  changelog   String?
  
  // Node code
  code        String   @db.Text // TypeScript/JavaScript code
  compiled    String?  @db.Text // Compiled JavaScript (if needed)
  sourceMap   String?  @db.Text // Source map for debugging
  
  // Dependencies
  dependencies Json?   // NPM dependencies
  
  // Node definition (from SDK)
  definition  Json     // ICustomNode interface fields
  properties  Json     // NodeProperty[]
  credentials Json?    // NodeCredential[]
  documentation Json?  // NodeDocumentation
  
  // Validation
  validated   Boolean  @default(false)
  validationErrors String?
  
  // Stats
  downloads   Int      @default(0)
  
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  
  node        CustomNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  
  @@unique([nodeId, version])
  @@index([nodeId])
  @@index([version])
}

model CustomNodeInstall {
  id             String   @id @default(cuid())
  nodeId         String
  version        String
  organizationId String?
  userId         String?
  
  // Installation status
  active         Boolean  @default(true)
  
  installedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  node           CustomNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([nodeId, organizationId, userId])
  @@index([nodeId])
  @@index([organizationId])
  @@index([userId])
}

model CustomNodeReview {
  id         String   @id @default(cuid())
  nodeId     String
  userId     String
  version    String?  // Reviewed version
  
  rating     Int      // 1-5 stars
  title      String?
  content    String?
  
  helpful    Int      @default(0)
  verified   Boolean  @default(false) // Verified purchase/install
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  node       CustomNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  
  @@unique([nodeId, userId])
  @@index([nodeId])
  @@index([userId])
  @@index([rating])
}

// -------------------------------------------------------
// ANALYTICS & METRICS
// -------------------------------------------------------
model ExecutionMetrics {
  id             String   @id @default(cuid())
  
  // Time period (daily aggregation)
  date           DateTime @db.Date
  hour           Int?     // Optional hour for hourly metrics
  
  // Scope
  organizationId String?
  workflowId     String?
  
  // Execution statistics
  totalExecutions     Int @default(0)
  successfulExecutions Int @default(0)
  failedExecutions    Int @default(0)
  cancelledExecutions Int @default(0)
  
  // Performance metrics
  avgDuration    Float @default(0) // milliseconds
  minDuration    Float @default(0)
  maxDuration    Float @default(0)
  p50Duration    Float @default(0) // median
  p95Duration    Float @default(0)
  p99Duration    Float @default(0)
  
  // Success rate
  successRate    Float @default(0) // percentage
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([date, organizationId, workflowId, hour])
  @@index([date])
  @@index([organizationId])
  @@index([workflowId])
}

model WorkflowMetrics {
  id             String   @id @default(cuid())
  workflowId     String   @unique
  workflow       Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  // Execution counts
  totalExecutions     Int @default(0)
  successfulExecutions Int @default(0)
  failedExecutions    Int @default(0)
  
  // Performance
  avgDuration    Float @default(0) // milliseconds
  lastDuration   Float @default(0)
  fastestDuration Float @default(0)
  slowestDuration Float @default(0)
  
  // Reliability
  successRate    Float @default(0) // percentage
  uptimeRate     Float @default(0) // percentage
  
  // Activity
  lastExecutionAt DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  
  // Resource usage
  avgMemoryUsage Float @default(0) // MB
  avgCpuUsage    Float @default(0) // percentage
  totalApiCalls  Int   @default(0)
  totalDbQueries Int   @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([successRate])
  @@index([avgDuration])
  @@index([lastExecutionAt])
}

model ResourceUsage {
  id             String   @id @default(cuid())
  
  // Time period
  timestamp      DateTime @default(now())
  date           DateTime @db.Date
  hour           Int
  
  // Scope
  organizationId String?
  executionId    String?
  
  // System metrics
  cpuUsage       Float @default(0) // percentage
  memoryUsage    Float @default(0) // MB
  diskUsage      Float @default(0) // MB
  
  // Network metrics
  networkIn      Float @default(0) // MB
  networkOut     Float @default(0) // MB
  
  // Application metrics
  activeExecutions Int @default(0)
  queuedExecutions Int @default(0)
  apiCallCount     Int @default(0)
  dbQueryCount     Int @default(0)
  cacheHitRate     Float @default(0) // percentage
  
  createdAt      DateTime @default(now())
  
  @@unique([date, hour, organizationId, executionId])
  @@index([timestamp])
  @@index([organizationId])
  @@index([executionId])
}

model CostTracking {
  id             String   @id @default(cuid())
  
  // Time period
  date           DateTime @db.Date
  
  // Scope
  organizationId String?
  workflowId     String?
  
  // API costs (external services)
  apiCosts       Json?    // { "openai": 1.23, "stripe": 0.45, ... }
  totalApiCost   Float @default(0)
  
  // Execution costs
  executionCount Int   @default(0)
  executionCost  Float @default(0) // Based on duration/resources
  
  // Storage costs
  storageCost    Float @default(0)
  
  // Total cost
  totalCost      Float @default(0)
  
  // Budget tracking
  budgetLimit    Float?
  budgetUsed     Float @default(0)
  budgetRemaining Float?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([date, organizationId, workflowId])
  @@index([date])
  @@index([organizationId])
  @@index([totalCost])
}

// -------------------------------------------------------
// ALERTING SYSTEM
// -------------------------------------------------------

model AlertRule {
  id             String   @id @default(cuid())
  
  // Basic info
  name           String
  description    String?
  enabled        Boolean  @default(true)
  
  // Scope
  organizationId String
  workflowId     String?  // null = organization-wide
  
  // Trigger conditions
  triggerType    AlertTriggerType
  conditions     Json     // Flexible condition storage
  
  // Evaluation settings
  evaluationInterval Int   @default(300) // seconds
  cooldownPeriod     Int   @default(900) // seconds to wait before re-alerting
  
  // Alert channels (many-to-many)
  channels       AlertRuleChannel[]
  
  // Alert history
  alerts         AlertHistory[]
  
  // Metadata
  lastTriggeredAt DateTime?
  lastEvaluatedAt DateTime?
  triggerCount    Int      @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([organizationId])
  @@index([workflowId])
  @@index([enabled])
  @@index([triggerType])
}

enum AlertTriggerType {
  EXECUTION_FAILED       // Workflow execution failed
  EXECUTION_SLOW         // Execution exceeded duration threshold
  ERROR_RATE_HIGH        // Error rate exceeded threshold
  SUCCESS_RATE_LOW       // Success rate below threshold
  SCHEDULE_MISSED        // Scheduled execution missed
  RESOURCE_LIMIT         // Resource usage exceeded limit
  COST_THRESHOLD         // Cost exceeded budget
  CUSTOM                 // Custom condition evaluation
}

model AlertChannel {
  id             String   @id @default(cuid())
  
  // Basic info
  name           String
  description    String?
  enabled        Boolean  @default(true)
  
  // Scope
  organizationId String
  
  // Channel type and configuration
  type           AlertChannelType
  config         Json     // Channel-specific configuration
  
  // Email config: { "to": ["email@example.com"], "from": "alerts@platform.com", "smtp": {...} }
  // Slack config: { "webhookUrl": "https://hooks.slack.com/...", "channel": "#alerts" }
  // Webhook config: { "url": "https://api.example.com/webhook", "method": "POST", "headers": {...} }
  
  // Alert rules using this channel
  rules          AlertRuleChannel[]
  
  // Statistics
  lastUsedAt     DateTime?
  alertsSent     Int      @default(0)
  alertsFailed   Int      @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([organizationId])
  @@index([type])
  @@index([enabled])
}

enum AlertChannelType {
  EMAIL
  SLACK
  WEBHOOK
  DISCORD
  TEAMS
  TELEGRAM
}

model AlertRuleChannel {
  id        String   @id @default(cuid())
  
  ruleId    String
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  channelId String
  channel   AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  // Channel-specific overrides
  config    Json?    // Override channel config for this rule
  
  createdAt DateTime @default(now())
  
  @@unique([ruleId, channelId])
  @@index([ruleId])
  @@index([channelId])
}

model AlertHistory {
  id             String   @id @default(cuid())
  
  // Alert rule
  ruleId         String
  rule           AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  // Trigger context
  workflowId     String?
  executionId    String?
  
  // Alert details
  severity       AlertSeverity
  message        String
  details        Json?    // Additional context
  
  // Delivery status
  channelsSent   Json     // { "channelId": { "status": "sent", "timestamp": "..." } }
  channelsFailed Json?    // Failed delivery attempts
  
  // Timestamps
  triggeredAt    DateTime @default(now())
  resolvedAt     DateTime?
  acknowledged   Boolean  @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?  // userId
  
  createdAt      DateTime @default(now())
  
  @@index([ruleId])
  @@index([workflowId])
  @@index([executionId])
  @@index([triggeredAt])
  @@index([severity])
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// -------------------------------------------------------
// MONITORING & HEALTH CHECKS
// -------------------------------------------------------

model SystemHealth {
  id             String   @id @default(cuid())
  
  // Component status
  component      String   // database, redis, worker, api, storage
  status         HealthStatus
  
  // Health metrics
  responseTime   Float?   // milliseconds
  uptime         Float?   // percentage
  lastCheck      DateTime @default(now())
  
  // Error information
  errorMessage   String?
  errorCount     Int      @default(0)
  
  // Additional metadata
  metadata       Json?    // Component-specific health data
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([component])
  @@index([status])
  @@index([lastCheck])
  @@index([component, lastCheck])
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

model UptimeMonitor {
  id             String   @id @default(cuid())
  
  // Service information
  serviceName    String
  serviceUrl     String?
  serviceType    String   // api, database, worker, external
  
  // Monitoring configuration
  checkInterval  Int      @default(60) // seconds
  timeout        Int      @default(30) // seconds
  enabled        Boolean  @default(true)
  
  // Status
  currentStatus  HealthStatus @default(UNKNOWN)
  lastStatusChange DateTime?
  
  // Uptime statistics
  totalChecks    Int      @default(0)
  successfulChecks Int    @default(0)
  failedChecks   Int      @default(0)
  uptimePercentage Float  @default(100)
  
  // Performance
  avgResponseTime Float   @default(0) // milliseconds
  lastResponseTime Float? // milliseconds
  
  // Timestamps
  lastCheckAt    DateTime?
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  
  // Organization scope (optional)
  organizationId String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  incidents      UptimeIncident[]
  checks         UptimeCheck[]
  
  @@unique([serviceName, organizationId])
  @@index([serviceName])
  @@index([serviceType])
  @@index([currentStatus])
  @@index([organizationId])
}

model UptimeCheck {
  id             String   @id @default(cuid())
  
  monitorId      String
  monitor        UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  
  // Check result
  status         HealthStatus
  responseTime   Float?   // milliseconds
  statusCode     Int?     // HTTP status code
  
  // Error information
  errorMessage   String?
  errorType      String?
  
  // Check metadata
  metadata       Json?
  
  checkedAt      DateTime @default(now())
  
  @@index([monitorId])
  @@index([status])
  @@index([checkedAt])
}

model UptimeIncident {
  id             String   @id @default(cuid())
  
  monitorId      String
  monitor        UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  
  // Incident information
  severity       AlertSeverity
  title          String
  description    String?
  
  // Status
  status         IncidentStatus @default(OPEN)
  
  // Timeline
  startedAt      DateTime @default(now())
  detectedAt     DateTime @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  
  // Duration
  duration       Int?     // seconds (calculated when resolved)
  
  // Impact
  affectedChecks Int      @default(0)
  downtime       Float    @default(0) // percentage during incident
  
  // Resolution
  resolvedBy     String?  // userId
  resolution     String?  // Resolution notes
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([monitorId])
  @@index([status])
  @@index([severity])
  @@index([startedAt])
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  CLOSED
}

model PerformanceMetric {
  id             String   @id @default(cuid())
  
  // Metric identification
  metricName     String   // api_response_time, db_query_time, node_execution_time, etc.
  metricType     MetricType
  
  // Scope
  organizationId String?
  workflowId     String?
  executionId    String?
  nodeId         String?
  endpoint       String?  // API endpoint
  
  // Metric values
  value          Float
  unit           String   // ms, s, bytes, count, percentage
  
  // Statistical aggregation
  min            Float?
  max            Float?
  avg            Float?
  p50            Float?
  p95            Float?
  p99            Float?
  count          Int?
  
  // Time window
  timestamp      DateTime @default(now())
  windowStart    DateTime?
  windowEnd      DateTime?
  
  // Metadata
  tags           Json?    // { "method": "GET", "status": "200", ... }
  
  createdAt      DateTime @default(now())
  
  @@index([metricName])
  @@index([metricType])
  @@index([organizationId])
  @@index([workflowId])
  @@index([executionId])
  @@index([timestamp])
}

enum MetricType {
  GAUGE        // Current value (e.g., memory usage)
  COUNTER      // Incrementing counter (e.g., request count)
  HISTOGRAM    // Distribution (e.g., response times)
  SUMMARY      // Statistical summary
}

model ErrorLog {
  id             String   @id @default(cuid())
  
  // Error classification
  errorType      String   // TypeError, ValidationError, NetworkError, etc.
  errorCode      String?  // Application-specific error code
  severity       AlertSeverity
  
  // Error details
  message        String
  stack          String?  @db.Text
  
  // Context
  organizationId String?
  workflowId     String?
  executionId    String?
  nodeId         String?
  userId         String?
  
  // Request context
  endpoint       String?
  method         String?
  statusCode     Int?
  
  // Environment
  environment    String?  // production, staging, development
  version        String?  // Application version
  
  // User agent & IP
  userAgent      String?
  ipAddress      String?
  
  // Grouping (for deduplication)
  fingerprint    String?  // Hash of error for grouping similar errors
  occurrences    Int      @default(1)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  
  // Resolution
  resolved       Boolean  @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?  // userId
  
  // Metadata
  metadata       Json?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([errorType])
  @@index([severity])
  @@index([organizationId])
  @@index([workflowId])
  @@index([executionId])
  @@index([fingerprint])
  @@index([resolved])
  @@index([createdAt])
}

model APMTrace {
  id             String   @id @default(cuid())
  
  // Trace identification
  traceId        String   // Distributed trace ID
  spanId         String   // Span ID
  parentSpanId   String?  // Parent span for nested operations
  
  // Operation details
  operationName  String   // e.g., "workflow.execute", "http.request", "db.query"
  operationType  String   // workflow, http, database, cache, etc.
  
  // Scope
  organizationId String?
  workflowId     String?
  executionId    String?
  nodeId         String?
  
  // Timing
  startTime      DateTime
  endTime        DateTime?
  duration       Float?   // milliseconds
  
  // Status
  status         TraceStatus
  statusCode     Int?
  
  // Error information
  error          Boolean  @default(false)
  errorMessage   String?
  errorType      String?
  
  // Tags and metadata
  tags           Json?    // { "http.method": "GET", "db.statement": "SELECT ...", ... }
  logs           Json?    // Span logs
  
  // Resource information
  serviceName    String?
  serviceVersion String?
  
  createdAt      DateTime @default(now())
  
  @@unique([traceId, spanId])
  @@index([traceId])
  @@index([spanId])
  @@index([parentSpanId])
  @@index([operationName])
  @@index([organizationId])
  @@index([workflowId])
  @@index([executionId])
  @@index([startTime])
  @@index([status])
}

enum TraceStatus {
  OK
  ERROR
  TIMEOUT
  CANCELLED
}

// -------------------------------------------------------
// ADVANCED SCHEDULING (Phase 5.1)
// -------------------------------------------------------

model ScheduleConfig {
  id             String   @id @default(cuid())
  workflowId     String   @unique
  workflow       Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  // Basic schedule
  cronExpression String   // Standard cron
  enabled        Boolean  @default(true)
  
  // Timezone support
  timezone       String   @default("UTC") // IANA timezone (e.g., "America/New_York")
  
  // Holiday awareness
  skipHolidays   Boolean  @default(false)
  holidayAction  HolidayAction @default(SKIP)
  holidayCalendarId String? // Reference to HolidayCalendar
  holidayCalendar HolidayCalendar? @relation(fields: [holidayCalendarId], references: [id])
  
  // Business hours
  businessHoursOnly Boolean @default(false)
  businessHoursConfig Json? // { monday: { start: "09:00", end: "17:00" }, ... }
  
  // Rate limiting
  maxExecutionsPerHour Int? // null = unlimited
  maxExecutionsPerDay  Int? // null = unlimited
  
  // Queueing strategy
  queueStrategy  QueueStrategy @default(FIFO)
  maxQueueSize   Int?   // null = unlimited
  priority       Int    @default(0) // Higher = more important
  
  // Concurrency
  maxConcurrent  Int    @default(1) // Max parallel executions
  
  // Metadata
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  exceptions     ScheduleException[]
  logs           ScheduleLog[]
  
  @@index([workflowId])
  @@index([enabled])
}

model HolidayCalendar {
  id             String   @id @default(cuid())
  name           String   // e.g., "US Federal Holidays", "Company Holidays"
  description    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Timezone for the calendar
  timezone       String   @default("UTC")
  
  // Public or private
  isPublic       Boolean  @default(false)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  holidays       Holiday[]
  scheduleConfigs ScheduleConfig[]
  
  @@index([organizationId])
  @@index([isPublic])
}

model Holiday {
  id         String   @id @default(cuid())
  calendarId String
  calendar   HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  
  name       String   // e.g., "New Year's Day", "Christmas"
  date       DateTime // Actual date
  isRecurring Boolean @default(false) // Recurs yearly?
  
  // For recurring holidays (e.g., "First Monday of September")
  recurrenceRule Json? // { type: "monthly", dayOfWeek: 1, weekOfMonth: 1 }
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([calendarId])
  @@index([date])
}

model ScheduleException {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   ScheduleConfig @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  // Exception type
  type       ExceptionType
  
  // Date/time range
  startDate  DateTime
  endDate    DateTime?
  
  // Action
  action     ExceptionAction @default(SKIP)
  
  // Alternative cron (if action = RESCHEDULE)
  alternativeCron String?
  
  // Reason/description
  reason     String?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([scheduleId])
  @@index([startDate])
}

model ScheduleLog {
  id             String   @id @default(cuid())
  scheduleId     String
  schedule       ScheduleConfig @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  // Execution details
  scheduledTime  DateTime // When it was supposed to run
  actualTime     DateTime? // When it actually ran
  status         ScheduleStatus
  
  // Skipped/delayed reasons
  skippedReason  String?  // e.g., "Holiday", "Outside business hours", "Rate limit"
  delayedBy      Int?     // milliseconds
  
  // Execution reference
  executionId    String?
  execution      Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  
  // Queue info
  queuePosition  Int?
  queueWaitTime  Int?     // milliseconds
  
  createdAt      DateTime @default(now())
  
  @@index([scheduleId])
  @@index([scheduledTime])
  @@index([status])
  @@index([executionId])
}

enum HolidayAction {
  SKIP          // Don't execute on holidays
  DELAY_TO_NEXT // Execute on next business day
  EXECUTE       // Execute anyway
}

enum QueueStrategy {
  FIFO          // First in, first out
  LIFO          // Last in, first out
  PRIORITY      // Based on priority field
  ROUND_ROBIN   // Distribute evenly
}

enum ExceptionType {
  ONE_TIME      // Specific date
  RECURRING     // Repeating pattern
  DATE_RANGE    // Range of dates
}

enum ExceptionAction {
  SKIP          // Don't execute
  RESCHEDULE    // Use alternative cron
  DELAY         // Delay by X hours
}

enum ScheduleStatus {
  SCHEDULED     // Waiting to execute
  EXECUTED      // Successfully executed
  SKIPPED       // Skipped due to holiday/business hours
  DELAYED       // Delayed due to rate limit/queue
  FAILED        // Failed to execute
  CANCELLED     // Manually cancelled
}

// -------------------------------------------------------
// VERSION CONTROL (Git-like)
// -------------------------------------------------------

model WorkflowCommit {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  branchId    String?
  branch      WorkflowBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  versionId   String
  version     WorkflowVersion @relation(fields: [versionId], references: [id])
  
  sha         String   @unique // Git-like commit hash
  message     String   // Commit message
  author      String   // User who made the commit
  authorId    String?  // Link to User
  
  parentSha   String?  // Previous commit SHA
  parent      WorkflowCommit? @relation("CommitHistory", fields: [parentSha], references: [sha], onDelete: SetNull)
  children    WorkflowCommit[] @relation("CommitHistory")
  
  branchHead  WorkflowBranch? @relation("BranchHead")
  
  changes     Json?    // Detailed change diff
  tags        String[] // Tags for this commit (e.g., "v1.0", "stable")
  
  createdAt   DateTime @default(now())
  
  @@index([workflowId])
  @@index([branchId])
  @@index([versionId])
  @@index([sha])
  @@index([parentSha])
  @@index([authorId])
}

model WorkflowBranch {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  name        String   // Branch name (e.g., "main", "dev", "feature/new-nodes")
  description String?
  
  headSha     String?  @unique // Current commit SHA
  headCommit  WorkflowCommit? @relation("BranchHead", fields: [headSha], references: [sha], onDelete: SetNull)
  
  isDefault   Boolean  @default(false)
  isProtected Boolean  @default(false)
  
  createdBy   String?  // User ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  commits     WorkflowCommit[]
  
  @@unique([workflowId, name])
  @@index([workflowId])
  @@index([headSha])
}

model WorkflowDiff {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  fromSha     String   // Source commit
  toSha       String   // Target commit
  
  diffType    DiffType
  diffData    Json     // Detailed diff information
  
  // Statistics
  nodesAdded     Int @default(0)
  nodesRemoved   Int @default(0)
  nodesModified  Int @default(0)
  connectionsAdded   Int @default(0)
  connectionsRemoved Int @default(0)
  settingsChanged    Boolean @default(false)
  
  createdAt   DateTime @default(now())
  
  @@unique([workflowId, fromSha, toSha])
  @@index([workflowId])
}

model WorkflowSnapshot {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  name        String   // Snapshot name
  description String?
  
  commitSha   String   // Associated commit
  definition  Json     // Full workflow definition
  
  createdBy   String?  // User ID
  createdAt   DateTime @default(now())
  
  @@index([workflowId])
  @@index([commitSha])
}

model WorkflowMergeRequest {
  id            String   @id @default(cuid())
  workflowId    String
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  title         String
  description   String?
  
  sourceBranch  String   // Branch to merge from
  targetBranch  String   // Branch to merge into
  
  status        MergeStatus @default(OPEN)
  
  createdBy     String?  // User ID
  assignedTo    String?  // User ID
  
  mergedAt      DateTime?
  mergedBy      String?  // User ID
  
  conflicts     Json?    // Merge conflicts if any
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([workflowId])
  @@index([status])
}

enum DiffType {
  NODES_CHANGED
  CONNECTIONS_CHANGED
  SETTINGS_CHANGED
  COMPLETE_REWRITE
  MINOR_CHANGE
}

enum MergeStatus {
  OPEN
  MERGED
  CLOSED
  CONFLICTED
}

// -------------------------------------------------------
// COLLABORATION FEATURES
// -------------------------------------------------------

// Workflow collaborators (users with access to edit/view workflows)
model WorkflowCollaborator {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  permission CollaboratorPermission @default(VIEW)
  
  // Presence tracking
  lastSeenAt DateTime?
  cursorPosition Json?  // {x: number, y: number, nodeId?: string}
  isActive   Boolean  @default(false)
  
  invitedBy  String?  // User ID who invited
  invitedAt  DateTime @default(now())
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([workflowId, userId])
  @@index([workflowId])
  @@index([userId])
  @@index([isActive])
}

enum CollaboratorPermission {
  VIEW      // Can only view
  COMMENT   // Can view and comment
  EDIT      // Can edit workflow
}

// Comments on workflows (thread-based)
model WorkflowComment {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content    String   @db.Text
  
  // Position in canvas (for node-specific comments)
  nodeId     String?  // If comment is on a specific node
  position   Json?    // {x: number, y: number} for canvas position
  
  // Threading
  parentId   String?
  parent     WorkflowComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    WorkflowComment[] @relation("CommentReplies")
  
  // Mentions
  mentions   Json?    // Array of user IDs mentioned in comment
  
  // Status
  resolved   Boolean  @default(false)
  resolvedBy String?  // User ID
  resolvedAt DateTime?
  
  // Engagement
  reactions  Json?    // {emoji: string, userIds: string[]}[]
  
  edited     Boolean  @default(false)
  editedAt   DateTime?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  notifications WorkflowNotification[]
  
  @@index([workflowId])
  @@index([userId])
  @@index([nodeId])
  @@index([parentId])
  @@index([resolved])
  @@index([createdAt])
}

// Activity feed for workflow changes
model WorkflowActivity {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  type       ActivityType
  action     String   // e.g., "workflow.created", "node.added", "comment.created"
  
  // Activity details
  targetType String?  // e.g., "node", "comment", "connection"
  targetId   String?  // ID of the target (nodeId, commentId, etc.)
  
  metadata   Json?    // Additional context about the change
  changes    Json?    // Before/after values for edits
  
  // For grouping similar activities
  batchId    String?  // Group related activities together
  
  createdAt  DateTime @default(now())
  
  // Relations
  notifications WorkflowNotification[]
  
  @@index([workflowId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([batchId])
}

enum ActivityType {
  WORKFLOW_CREATED
  WORKFLOW_UPDATED
  WORKFLOW_DELETED
  WORKFLOW_PUBLISHED
  WORKFLOW_ACTIVATED
  WORKFLOW_DEACTIVATED
  
  NODE_ADDED
  NODE_UPDATED
  NODE_DELETED
  NODE_MOVED
  
  CONNECTION_ADDED
  CONNECTION_DELETED
  
  COMMENT_ADDED
  COMMENT_UPDATED
  COMMENT_DELETED
  COMMENT_RESOLVED
  
  COLLABORATOR_ADDED
  COLLABORATOR_REMOVED
  
  EXECUTION_STARTED
  EXECUTION_COMPLETED
  EXECUTION_FAILED
}

// Notifications for @mentions and workflow changes
model WorkflowNotification {
  id         String   @id @default(cuid())
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  type       NotificationType
  title      String
  message    String   @db.Text
  
  // Source of notification
  activityId String?
  activity   WorkflowActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  commentId  String?
  comment    WorkflowComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  // Notification metadata
  actionUrl  String?  // Deep link to the relevant part of workflow
  metadata   Json?
  
  // Status
  read       Boolean  @default(false)
  readAt     DateTime?
  
  dismissed  Boolean  @default(false)
  dismissedAt DateTime?
  
  createdAt  DateTime @default(now())
  
  @@index([userId])
  @@index([workflowId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  MENTION           // @mentioned in comment
  COMMENT_REPLY     // Reply to your comment
  COMMENT_RESOLVED  // Your comment was resolved
  
  WORKFLOW_SHARED   // Workflow shared with you
  WORKFLOW_UPDATED  // Workflow you're watching was updated
  
  EXECUTION_FAILED  // Workflow execution failed
  EXECUTION_SUCCESS // Workflow execution succeeded (if watching)
  
  COLLABORATOR_JOINED  // New collaborator joined
}
