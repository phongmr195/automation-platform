datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------
// AUTHENTICATION & USERS
// -------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // bcrypt hashed (nullable for OAuth-only users)
  name      String?
  avatar    String?  // Profile picture URL
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OAuth provider IDs
  googleId   String? @unique
  githubId   String? @unique
  linkedinId String? @unique

  sessions    Session[]
  workflows   Workflow[]
  credentials Credential[]
  organizationMembers OrganizationMember[]
  auditLogs   AuditLog[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// -------------------------------------------------------
// ORGANIZATION & MULTI-TENANCY
// -------------------------------------------------------
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  workflows   Workflow[]
  credentials Credential[]
  auditLogs   AuditLog[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action         String        // e.g., "workflow.created", "member.invited"
  resourceType   String        // e.g., "workflow", "member", "credential"
  resourceId     String?
  metadata       Json?         // Additional context
  ipAddress      String?
  userAgent      String?
  
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// -------------------------------------------------------
// WORKFLOW
// -------------------------------------------------------
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(false)
  
  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Owner
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  
  // Workflow definition (nodes, connections)
  nodes       Json     @default("[]")
  connections Json     @default("[]")
  
  // Triggers & Settings
  triggers    Json     @default("[]")
  settings    Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Published version
  publishedVersionId String?          @unique
  publishedVersion   WorkflowVersion? @relation("PublishedVersionRelation", fields: [publishedVersionId], references: [id])

  // All versions
  versions WorkflowVersion[]

  executions Execution[]

  @@index([organizationId])
  @@index([ownerId])
}

// -------------------------------------------------------
// WORKFLOW VERSION
// -------------------------------------------------------
model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  versionNumber Int
  definition    Json
  isDraft       Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Back relation for published version
  publishedInWorkflow Workflow? @relation("PublishedVersionRelation")

  executions Execution[]
}

// -------------------------------------------------------
// EXECUTION
// -------------------------------------------------------
model Execution {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  versionId String?
  version   WorkflowVersion? @relation(fields: [versionId], references: [id])

  status     String   // 'pending' | 'running' | 'success' | 'failed' | 'cancelled'
  input      Json?
  output     Json?
  error      String?
  nodeResults Json?   // Results from each node
  definitionSnapshot Json?
  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs NodeLog[]
}

// -------------------------------------------------------
// NODE LOG
// -------------------------------------------------------
model NodeLog {
  id String @id @default(cuid())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id])

  nodeId String
  status String
  data   Json?

  createdAt DateTime @default(now())
}

model Credential {
  id        String   @id @default(cuid())
  ownerId   String   // user id
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name      String
  provider  String   // e.g., "openai", "google", "slack", "http"
  type      String   // "apiKey" | "oauth" | "basic"
  encrypted Bytes    // ciphertext
  iv        Bytes
  meta      Json?    // e.g. { scopes: [...], expiresAt: '...' }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([organizationId])
}
