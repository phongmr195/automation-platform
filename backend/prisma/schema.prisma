datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------
// AUTHENTICATION & USERS
// -------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // bcrypt hashed (nullable for OAuth-only users)
  name      String?
  avatar    String?  // Profile picture URL
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OAuth provider IDs
  googleId   String? @unique
  githubId   String? @unique
  linkedinId String? @unique

  sessions    Session[]
  workflows   Workflow[]
  credentials Credential[]
  organizationMembers OrganizationMember[]
  auditLogs   AuditLog[]
  templates   WorkflowTemplate[]
  templateReviews TemplateReview[]
  templateComments TemplateComment[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// -------------------------------------------------------
// ORGANIZATION & MULTI-TENANCY
// -------------------------------------------------------
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  workflows   Workflow[]
  credentials Credential[]
  auditLogs   AuditLog[]
  folders     WorkflowFolder[]
  customNodeInstalls CustomNodeInstall[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action         String        // e.g., "workflow.created", "member.invited"
  resourceType   String        // e.g., "workflow", "member", "credential"
  resourceId     String?
  metadata       Json?         // Additional context
  ipAddress      String?
  userAgent      String?
  
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// -------------------------------------------------------
// WORKFLOW
// -------------------------------------------------------
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(false)
  
  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Owner
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  
  // Workflow definition (nodes, connections)
  nodes       Json     @default("[]")
  connections Json     @default("[]")
  
  // Triggers & Settings
  triggers    Json     @default("[]")
  settings    Json?
  
  // Organization features
  starred     Boolean  @default(false)
  folderId    String?
  folder      WorkflowFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  lastOpenedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Published version
  publishedVersionId String?          @unique
  publishedVersion   WorkflowVersion? @relation("PublishedVersionRelation", fields: [publishedVersionId], references: [id])

  // All versions
  versions WorkflowVersion[]

  executions Execution[]
  metrics    WorkflowMetrics?

  @@index([organizationId])
  @@index([ownerId])
  @@index([folderId])
  @@index([starred])
  @@index([lastOpenedAt])
}

// -------------------------------------------------------
// WORKFLOW FOLDER
// -------------------------------------------------------
model WorkflowFolder {
  id             String   @id @default(cuid())
  name           String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workflows Workflow[]

  @@index([organizationId])
}

// -------------------------------------------------------
// WORKFLOW VERSION
// -------------------------------------------------------
model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  versionNumber Int
  definition    Json
  isDraft       Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Back relation for published version
  publishedInWorkflow Workflow? @relation("PublishedVersionRelation")

  executions Execution[]
}

// -------------------------------------------------------
// EXECUTION
// -------------------------------------------------------
model Execution {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  versionId String?
  version   WorkflowVersion? @relation(fields: [versionId], references: [id])

  status     String   // 'pending' | 'running' | 'success' | 'failed' | 'cancelled'
  input      Json?
  output     Json?
  error      String?
  nodeResults Json?   // Results from each node
  definitionSnapshot Json?
  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs NodeLog[]
}

// -------------------------------------------------------
// NODE LOG
// -------------------------------------------------------
model NodeLog {
  id String @id @default(cuid())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id])

  nodeId String
  status String
  data   Json?

  createdAt DateTime @default(now())
}

model Credential {
  id        String   @id @default(cuid())
  ownerId   String   // user id
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Multi-tenancy
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name      String
  provider  String   // e.g., "openai", "google", "slack", "http"
  type      String   // "apiKey" | "oauth" | "basic"
  encrypted Bytes    // ciphertext
  iv        Bytes
  meta      Json?    // e.g. { scopes: [...], expiresAt: '...' }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([organizationId])
}

// -------------------------------------------------------
// WORKFLOW TEMPLATES
// -------------------------------------------------------
model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // e.g., "marketing", "data-sync", "notifications", "etl", "api-integration", "social-media"
  tags        String[] // Searchable tags
  
  // Template metadata
  icon        String?  // Icon identifier or emoji
  difficulty  String   @default("beginner") // "beginner" | "intermediate" | "advanced"
  estimatedTime String?  // e.g., "5 minutes", "1 hour"
  featured    Boolean  @default(false)
  
  // Template definition
  nodes       Json     @default("[]")
  connections Json     @default("[]")
  triggers    Json     @default("[]")
  settings    Json?
  
  // Configuration parameters that users need to fill
  requiredParams Json?  // List of parameters users must configure
  
  // Version control
  version     String   @default("1.0.0")
  changelog   String?
  
  // Usage statistics
  installCount Int     @default(0)
  rating      Float?   @default(0)
  
  // Author info
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  // Publishing
  published   Boolean  @default(true)
  publishedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Marketplace relations
  reviews     TemplateReview[]
  comments    TemplateComment[]

  @@index([category])
  @@index([featured])
  @@index([published])
  @@index([authorId])
}

// -------------------------------------------------------
// TEMPLATE REVIEWS & RATINGS
// -------------------------------------------------------
model TemplateReview {
  id         String   @id @default(cuid())
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating     Int      // 1-5 stars
  title      String?  // Review title
  content    String?  // Review text
  
  // Helpful votes
  helpfulCount Int    @default(0)
  
  // Moderation
  verified   Boolean  @default(false) // Verified purchase/usage
  featured   Boolean  @default(false)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([templateId, userId]) // One review per user per template
  @@index([templateId])
  @@index([userId])
  @@index([rating])
}

// -------------------------------------------------------
// TEMPLATE COMMENTS
// -------------------------------------------------------
model TemplateComment {
  id         String   @id @default(cuid())
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content    String
  
  // Threading (replies)
  parentId   String?
  parent     TemplateComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    TemplateComment[] @relation("CommentReplies")
  
  // Engagement
  upvotes    Int      @default(0)
  
  // Moderation
  edited     Boolean  @default(false)
  deleted    Boolean  @default(false)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([templateId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

// -------------------------------------------------------
// CUSTOM NODES (Like n8n Community Nodes)
// -------------------------------------------------------
model CustomNode {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "my-custom-node"
  displayName String   // e.g., "My Custom Node"
  description String
  author      String   // User ID or organization
  authorName  String   // Display name
  category    String   // e.g., "communication", "transform", "integration"
  icon        String?  // Icon name or URL
  iconUrl     String?
  color       String?  // Hex color
  
  // Publishing status
  status      String   @default("draft") // draft, published, deprecated
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  verified    Boolean  @default(false) // Verified by platform
  
  // Metadata
  repository  String?  // GitHub repo URL
  homepage    String?  // Documentation URL
  license     String?  // MIT, Apache-2.0, etc.
  keywords    String[] // Search keywords
  
  // Stats
  downloads   Int      @default(0)
  installs    Int      @default(0)
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
  
  // Relations
  versions    CustomNodeVersion[]
  installs_rel CustomNodeInstall[]
  reviews     CustomNodeReview[]
  
  @@index([name])
  @@index([category])
  @@index([published])
  @@index([featured])
  @@index([downloads])
  @@index([rating])
}

model CustomNodeVersion {
  id          String   @id @default(cuid())
  nodeId      String
  version     String   // Semver: 1.0.0
  changelog   String?
  
  // Node code
  code        String   @db.Text // TypeScript/JavaScript code
  compiled    String?  @db.Text // Compiled JavaScript (if needed)
  sourceMap   String?  @db.Text // Source map for debugging
  
  // Dependencies
  dependencies Json?   // NPM dependencies
  
  // Node definition (from SDK)
  definition  Json     // ICustomNode interface fields
  properties  Json     // NodeProperty[]
  credentials Json?    // NodeCredential[]
  documentation Json?  // NodeDocumentation
  
  // Validation
  validated   Boolean  @default(false)
  validationErrors String?
  
  // Stats
  downloads   Int      @default(0)
  
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  
  node        CustomNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  
  @@unique([nodeId, version])
  @@index([nodeId])
  @@index([version])
}

model CustomNodeInstall {
  id             String   @id @default(cuid())
  nodeId         String
  version        String
  organizationId String?
  userId         String?
  
  // Installation status
  active         Boolean  @default(true)
  
  installedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  node           CustomNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([nodeId, organizationId, userId])
  @@index([nodeId])
  @@index([organizationId])
  @@index([userId])
}

model CustomNodeReview {
  id         String   @id @default(cuid())
  nodeId     String
  userId     String
  version    String?  // Reviewed version
  
  rating     Int      // 1-5 stars
  title      String?
  content    String?
  
  helpful    Int      @default(0)
  verified   Boolean  @default(false) // Verified purchase/install
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  node       CustomNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  
  @@unique([nodeId, userId])
  @@index([nodeId])
  @@index([userId])
  @@index([rating])
}

// -------------------------------------------------------
// ANALYTICS & METRICS
// -------------------------------------------------------
model ExecutionMetrics {
  id             String   @id @default(cuid())
  
  // Time period (daily aggregation)
  date           DateTime @db.Date
  hour           Int?     // Optional hour for hourly metrics
  
  // Scope
  organizationId String?
  workflowId     String?
  
  // Execution statistics
  totalExecutions     Int @default(0)
  successfulExecutions Int @default(0)
  failedExecutions    Int @default(0)
  cancelledExecutions Int @default(0)
  
  // Performance metrics
  avgDuration    Float @default(0) // milliseconds
  minDuration    Float @default(0)
  maxDuration    Float @default(0)
  p50Duration    Float @default(0) // median
  p95Duration    Float @default(0)
  p99Duration    Float @default(0)
  
  // Success rate
  successRate    Float @default(0) // percentage
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([date, organizationId, workflowId, hour])
  @@index([date])
  @@index([organizationId])
  @@index([workflowId])
}

model WorkflowMetrics {
  id             String   @id @default(cuid())
  workflowId     String   @unique
  workflow       Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  // Execution counts
  totalExecutions     Int @default(0)
  successfulExecutions Int @default(0)
  failedExecutions    Int @default(0)
  
  // Performance
  avgDuration    Float @default(0) // milliseconds
  lastDuration   Float @default(0)
  fastestDuration Float @default(0)
  slowestDuration Float @default(0)
  
  // Reliability
  successRate    Float @default(0) // percentage
  uptimeRate     Float @default(0) // percentage
  
  // Activity
  lastExecutionAt DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  
  // Resource usage
  avgMemoryUsage Float @default(0) // MB
  avgCpuUsage    Float @default(0) // percentage
  totalApiCalls  Int   @default(0)
  totalDbQueries Int   @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([successRate])
  @@index([avgDuration])
  @@index([lastExecutionAt])
}

model ResourceUsage {
  id             String   @id @default(cuid())
  
  // Time period
  timestamp      DateTime @default(now())
  date           DateTime @db.Date
  hour           Int
  
  // Scope
  organizationId String?
  executionId    String?
  
  // System metrics
  cpuUsage       Float @default(0) // percentage
  memoryUsage    Float @default(0) // MB
  diskUsage      Float @default(0) // MB
  
  // Network metrics
  networkIn      Float @default(0) // MB
  networkOut     Float @default(0) // MB
  
  // Application metrics
  activeExecutions Int @default(0)
  queuedExecutions Int @default(0)
  apiCallCount     Int @default(0)
  dbQueryCount     Int @default(0)
  cacheHitRate     Float @default(0) // percentage
  
  createdAt      DateTime @default(now())
  
  @@unique([date, hour, organizationId, executionId])
  @@index([timestamp])
  @@index([organizationId])
  @@index([executionId])
}

model CostTracking {
  id             String   @id @default(cuid())
  
  // Time period
  date           DateTime @db.Date
  
  // Scope
  organizationId String?
  workflowId     String?
  
  // API costs (external services)
  apiCosts       Json?    // { "openai": 1.23, "stripe": 0.45, ... }
  totalApiCost   Float @default(0)
  
  // Execution costs
  executionCount Int   @default(0)
  executionCost  Float @default(0) // Based on duration/resources
  
  // Storage costs
  storageCost    Float @default(0)
  
  // Total cost
  totalCost      Float @default(0)
  
  // Budget tracking
  budgetLimit    Float?
  budgetUsed     Float @default(0)
  budgetRemaining Float?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([date, organizationId, workflowId])
  @@index([date])
  @@index([organizationId])
  @@index([totalCost])
}

// -------------------------------------------------------
// ALERTING SYSTEM
// -------------------------------------------------------

model AlertRule {
  id             String   @id @default(cuid())
  
  // Basic info
  name           String
  description    String?
  enabled        Boolean  @default(true)
  
  // Scope
  organizationId String
  workflowId     String?  // null = organization-wide
  
  // Trigger conditions
  triggerType    AlertTriggerType
  conditions     Json     // Flexible condition storage
  
  // Evaluation settings
  evaluationInterval Int   @default(300) // seconds
  cooldownPeriod     Int   @default(900) // seconds to wait before re-alerting
  
  // Alert channels (many-to-many)
  channels       AlertRuleChannel[]
  
  // Alert history
  alerts         AlertHistory[]
  
  // Metadata
  lastTriggeredAt DateTime?
  lastEvaluatedAt DateTime?
  triggerCount    Int      @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([organizationId])
  @@index([workflowId])
  @@index([enabled])
  @@index([triggerType])
}

enum AlertTriggerType {
  EXECUTION_FAILED       // Workflow execution failed
  EXECUTION_SLOW         // Execution exceeded duration threshold
  ERROR_RATE_HIGH        // Error rate exceeded threshold
  SUCCESS_RATE_LOW       // Success rate below threshold
  SCHEDULE_MISSED        // Scheduled execution missed
  RESOURCE_LIMIT         // Resource usage exceeded limit
  COST_THRESHOLD         // Cost exceeded budget
  CUSTOM                 // Custom condition evaluation
}

model AlertChannel {
  id             String   @id @default(cuid())
  
  // Basic info
  name           String
  description    String?
  enabled        Boolean  @default(true)
  
  // Scope
  organizationId String
  
  // Channel type and configuration
  type           AlertChannelType
  config         Json     // Channel-specific configuration
  
  // Email config: { "to": ["email@example.com"], "from": "alerts@platform.com", "smtp": {...} }
  // Slack config: { "webhookUrl": "https://hooks.slack.com/...", "channel": "#alerts" }
  // Webhook config: { "url": "https://api.example.com/webhook", "method": "POST", "headers": {...} }
  
  // Alert rules using this channel
  rules          AlertRuleChannel[]
  
  // Statistics
  lastUsedAt     DateTime?
  alertsSent     Int      @default(0)
  alertsFailed   Int      @default(0)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([organizationId])
  @@index([type])
  @@index([enabled])
}

enum AlertChannelType {
  EMAIL
  SLACK
  WEBHOOK
  DISCORD
  TEAMS
  TELEGRAM
}

model AlertRuleChannel {
  id        String   @id @default(cuid())
  
  ruleId    String
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  channelId String
  channel   AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  
  // Channel-specific overrides
  config    Json?    // Override channel config for this rule
  
  createdAt DateTime @default(now())
  
  @@unique([ruleId, channelId])
  @@index([ruleId])
  @@index([channelId])
}

model AlertHistory {
  id             String   @id @default(cuid())
  
  // Alert rule
  ruleId         String
  rule           AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  
  // Trigger context
  workflowId     String?
  executionId    String?
  
  // Alert details
  severity       AlertSeverity
  message        String
  details        Json?    // Additional context
  
  // Delivery status
  channelsSent   Json     // { "channelId": { "status": "sent", "timestamp": "..." } }
  channelsFailed Json?    // Failed delivery attempts
  
  // Timestamps
  triggeredAt    DateTime @default(now())
  resolvedAt     DateTime?
  acknowledged   Boolean  @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?  // userId
  
  createdAt      DateTime @default(now())
  
  @@index([ruleId])
  @@index([workflowId])
  @@index([executionId])
  @@index([triggeredAt])
  @@index([severity])
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}
